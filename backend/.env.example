# Backend (copy to backend/.env). Only the first block is needed locally.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
FRONTEND_URL=http://localhost:3000
GROQ_API_KEY=

# Optional
DATABASE_URL=            # empty = local SQLite (backend/instance/icon.db)
STARTUP_TASKS=1          # 0 in production; run `python bootstrap.py` instead
DISABLE_SCHEDULER=0
SCRAPER_SECRET=
ADMIN_SECRET=
SARAMIN_API_KEY=
# Google sign-in: the OAuth client ID(s) tokens must be issued to, comma-separated
GOOGLE_CLIENT_ID=
# Daily opportunities post to Telegram (bot from @BotFather, added as channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Telegram user ids that may send the bot links to add and post (comma-separated)
TELEGRAM_ADMIN_IDS=
# Daily post on Instagram (business account linked to a Facebook Page)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Daily post on the ICOM Facebook Page (waits for approval like Instagram)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
ABSTRACT_EMAIL_API_KEY=
