# Backend (copy to backend/.env). Only the first block is needed locally.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
FRONTEND_URL=http://localhost:3000
GROQ_API_KEY=

# Optional
DATABASE_URL=            # empty = local SQLite (backend/instance/icon.db)
STARTUP_TASKS=1          # 0 in production; run `python bootstrap.py` instead
DISABLE_SCHEDULER=0
SCRAPER_SECRET=
ADMIN_SECRET=
SARAMIN_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
ABSTRACT_EMAIL_API_KEY=
