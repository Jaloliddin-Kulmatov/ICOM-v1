# Copy to .env and fill in. Search, citation maps, credibility scores, and
# exports all work WITHOUT a key. The reviewer/weaknesses/beginner/reproduce/
# debate/reading-plan features need this set.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-opus-4-8.
# RA_MODEL=claude-opus-4-8

# Optional Flask settings
# FLASK_DEBUG=1
# PORT=5057
